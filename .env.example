# IntellOps — Variables de entorno (copiar a .env)
#
# Usadas por docker-compose.yml para intellops-db y la cadena de
# conexión que consumen intellops-core, intellops-ai-engine e
# intellops-comms.

POSTGRES_USER=intellops
POSTGRES_PASSWORD=intellops
POSTGRES_DB=intellops

# --- JWT (ISS-S2-01) -----------------------------------------------------
# Secret de firma HS256 — mínimo 32 bytes (AUTH-6). El valor de abajo es
# SOLO dev/CI; en producción override con un secreto real (>=32 chars).
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# Password dev del seed Admin (migración 0002, admin@intellops.local).
# Solo dev/CI — en producción crear usuarios por API y rotar este valor.
ADMIN_BOOTSTRAP_PASSWORD=admin-dev-password